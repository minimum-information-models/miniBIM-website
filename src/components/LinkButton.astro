---
const { href, type, ...other } = Astro.props;
---
<style>
    .button {
        --base-color: var(--white);
        --text-color: var(--black);
        --border-color: color-mix(in srgb, var(--base-color) 80%, #000000);

        font-weight: 600;
        font-size: 0.9rem;
        display: inline-block;
        background-color: var(--base-color);
        color: var(--text-color);
        border: 0;
        border-bottom: 0.2rem solid var(--border-color);
        padding: 0.6rem 1.0rem 0.4rem 1.0rem;
        border-radius: var(--border-radius);
        text-decoration: none;

        &:not(.primary):hover {
            border-bottom-color: color-mix(in srgb, var(--base-color) 80%, var(--gray));
            background-color: var(--white);
        }

        &:is(.primary):hover {
            border-bottom-color: var(--base-color);
            background-color: color-mix(in srgb, var(--base-color) 80%, var(--white));
        }

        &.primary {
            --base-color: var(--primary-color);
            --text-color: white;
            --border-color: color-mix(in srgb, var(--base-color) 80%, #000000);
        }
    }
</style>
<a href={href} class={"button " + type} role="button" {...other}><slot /></a>